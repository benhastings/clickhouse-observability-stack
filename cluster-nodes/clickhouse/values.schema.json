{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "base name of every object",
      "x-default": "release name"
    },
    "common": {
      "type": "object",
