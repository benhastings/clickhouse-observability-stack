    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "deliver every container's `secretEnv` through the Vault Agent Injector instead of `secretKeyRef`; see Secrets below",
          "x-default": "`false`"
