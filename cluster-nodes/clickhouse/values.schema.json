            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer"
              },
              "targetPort": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "protocol": {
                "type": "string"
              },
              "appProtocol": {
                "type": "string"
              }
            }
          },
          "description": "`port`, `targetPort` (defaults to the port name), `protocol` (`TCP`), `appProtocol`"
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "the key under `global.exposure.hosts` this app is reachable on, once `global.exposure.enabled` is true: an Ingress with `global.mesh: kubernetes`, a Gateway and VirtualService with `istio`",
          "x-default": "`\"\"`"
        },
        "port": {
          "type": "string",
          "description": "the name of the `service.ports` entry the host routes to",
          "x-default": "`\"\"`"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap",
          "description": "annotations on the Ingress, such as a controller's body-size limit",
          "x-default": "`{}`"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "set `false` to leave this app out when `global.networkPolicy.enabled`",
          "x-default": "`true`"
        },
        "podSelector": {
          "type": "object",
          "description": "a full label selector for the pods the policy covers; empty selects `app.kubernetes.io/name: <name>`",
          "x-default": "`{}`"
        },
        "ingress": {
          "type": [
            "array",
            "string"
          ],
          "description": "NetworkPolicy ingress rules, a list or a templated string; see Network policies",
          "x-default": "`[]`"
        },
        "egress": {
          "type": [
            "array",
            "string"
          ],
          "description": "NetworkPolicy egress rules after DNS (and istiod under `istio`), a list or a templated string",
          "x-default": "`[]`"
        }
      }
    },
    "configMaps": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object"
          },
          "files": {
            "type": "string"
          }
        }
