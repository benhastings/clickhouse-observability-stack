        "rules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "when set, a Role and RoleBinding in the release namespace",
          "x-default": "`[]`"
        }
      }
    },
    "deployment": {
      "$ref": "#/definitions/workload"
    },
    "daemonset": {
      "$ref": "#/definitions/workload",
      "x-doc-rows": [
        {
          "key": "daemonset.enabled",
          "default": "`false`",
          "description": "render a DaemonSet; see DaemonSet below"
        },
        {
          "key": "daemonset.updateStrategy",
          "default": "`RollingUpdate`",
          "description": ""
        },
        {
          "key": "daemonset.selectorLabels",
          "default": "`{}`",
          "description": "merged over the base selector labels on the DaemonSet's selector and pods"
        },
        {
          "key": "daemonset.podLabels … daemonset.volumes",
          "default": "as `deployment`",
          "description": "the same pod, scheduling, container and volume keys as `deployment`, except `replicas` and `strategy`"
        }
      ],
      "x-doc-leaf": true
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "render a `policy/v1` PodDisruptionBudget selecting the Deployment's pods",
          "x-default": "`false`"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string",
            "null"
          ],
          "description": "a count or a percentage; set to `null` to use `maxUnavailable`",
          "x-default": "`1`"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string",
            "null"
          ],
          "description": "a count or a percentage; mutually exclusive with `minAvailable`",
          "x-default": "unset"
