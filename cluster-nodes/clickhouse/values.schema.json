        "role": {
          "type": "string",
          "description": "the Vault Kubernetes auth role the pod logs in as",
          "x-default": "chart name"
        },
        "path": {
          "type": "string",
          "description": "KV v2 prefix; a secret is read from `<path>/<secretEnv.secret>`",
          "x-default": "`secret/data`"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap",
          "description": "extra `vault.hashicorp.com/*` pod annotations, such as `agent-pre-populate-only`",
          "x-default": "`{}`"
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mesh": {
          "type": "string",
          "description": "the service mesh the cluster runs: `istio` or `kubernetes`; anything else fails the render. `istio` renders a DestinationRule (`ISTIO_MUTUAL`) for every Service and, with exposure on, a Gateway and VirtualService per app; `kubernetes` renders none of them, and an Ingress for exposure",
          "x-default": "`istio`"
        },
        "namespace": {
          "type": "string",
          "description": "namespace of every namespaced object",
          "x-default": "release namespace"
        },
        "labels": {
          "$ref": "#/definitions/stringMap",
          "description": "extra labels on every object",
          "x-default": "`{}`"
        },
        "imageRegistry": {
          "type": "string",
          "description": "prepended to every image, so `registry.example/mirror` turns `grafana/grafana:13.2.2` into `registry.example/mirror/grafana/grafana:13.2.2`. An image that names its own registry keeps it in the path (`registry.example/mirror/ghcr.io/...`), which is how pull-through mirrors lay them out. Empty uses each image as written. Nodes that render images outside the common Deployment, such as ClickHouse's Installation and backup job, use the same `common.image` helper",
          "x-default": "`\"\"`"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Secret names put on every pod that sets no `imagePullSecrets` of its own. A workload's list replaces this one, as Helm does for lists",
          "x-default": "`[]`"
        },
        "vault": {
          "$ref": "#/definitions/vault",
          "description": "the same keys as `vault`, for every app at once; an app's own `vault` wins",
          "x-doc-leaf": true
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clickhouse": {
              "type": "string",
              "description": "where the collector and Cerberus reach ClickHouse's native protocol",
              "x-default": "`clickhouse:9000`"
            },
            "cerberus": {
              "type": "string",
              "description": "where Grafana's datasources reach Cerberus",
              "x-default": "`http://cerberus:8080`"
            },
            "otlpGrpc": {
              "type": "string",
              "description": "where the demo load sends OTLP over gRPC",
              "x-default": "`otel-collector:4317`"
            }
          }
        },
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "render an `ExternalSecret` in place of every Secret in `secrets` that has `external.keys`",
              "x-default": "`false`"
            },
            "secretStoreRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "SecretStore",
                    "ClusterSecretStore"
                  ]
                }
              },
              "description": "the store the site runs; an enabled render fails without a name",
              "x-default": "`{name: \"\", kind: ClusterSecretStore}`"
            },
            "remotePath": {
              "type": "string",
              "description": "a Secret is read from `<remotePath>/<Secret name>`, one property per key",
              "x-default": "`observability`"
            },
            "refreshInterval": {
              "type": "string",
              "description": "how often the operator re-reads the store",
              "x-default": "`1h`"
            }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "make the apps that set `exposure.host` reachable from outside the cluster",
              "x-default": "`false`"
            },
            "hosts": {
              "$ref": "#/definitions/stringMap",
              "description": "the hostname for each key an app can name in `exposure.host`, such as `grafana` or `otlp`; an enabled exposure fails the render when an app's host is empty",
              "x-default": "`{}`",
              "x-doc-key": "<key>"
            },
            "ingressClassName": {
              "type": "string",
              "description": "the Ingress class; empty uses the cluster default",
              "x-default": "`\"\"`"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "credentialName": {
                  "type": "string",
                  "description": "a TLS Secret the site creates, used for every exposed host; empty serves plain HTTP. With Istio, the Secret lives in the ingress gateway's namespace (usually `istio-system`)",
                  "x-default": "`\"\"`"
                }
              }
            },
            "gateway": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "with `istio`, an existing Gateway to bind every VirtualService to; no Gateway is rendered. Empty gives each app its own Gateway for its own host (443 with a TLS credential, 80 without)",
                  "x-default": "`\"\"`"
                },
                "namespace": {
                  "type": "string",
                  "description": "the namespace of that existing Gateway",
                  "x-default": "release namespace"
                },
                "selector": {
                  "$ref": "#/definitions/stringMap",
                  "description": "which ingress gateway pods the rendered Gateways select",
                  "x-default": "`{istio: ingressgateway}`"
                }
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "render a NetworkPolicy for every app; see Network policies",
              "x-default": "`false`"
            },
            "exposureNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "namespaces whose pods may reach an exposed app (the ingress gateway or controller)",
              "x-default": "`[]`"
            },
            "istioNamespace": {
              "type": "string",
              "description": "where istiod runs, for the sidecar's egress under `mesh: istio`",
              "x-default": "`istio-system`"
            },
            "namespaces": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stack": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                }
              },
              "description": "the stack's and the operator's namespaces, for rules that cross between them",
              "x-default": "`{stack: observability, operator: clickhouse-operator}`"
            }
          }
        }
      }
