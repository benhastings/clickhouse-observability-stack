    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "render a Service selecting the Deployment's pods",
          "x-default": "`false`"
        },
        "type": {
          "type": "string",
          "description": "",
          "x-default": "`ClusterIP`"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap",
          "description": "",
          "x-default": "`{}`"
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
