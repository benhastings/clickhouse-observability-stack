    "enabled": {
      "type": "boolean",
      "description": "read only by the `cluster-configs/stack` umbrella chart, which turns each node on or off with it"
    },
    "global": {
      "$ref": "#/definitions/global"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "render a ServiceAccount named after the chart",
          "x-default": "`true`"
        },
        "name": {
          "type": "string",
          "description": "override the name",
          "x-default": "chart name, or `default` when not created"
        },
        "automountToken": {
          "type": "boolean",
          "description": "also applied to the pod spec",
          "x-default": "`false`"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap",
          "description": "",
          "x-default": "`{}`"
        }
      }
    },
    "rbac": {
      "type": "object",
