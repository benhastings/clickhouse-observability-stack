          "type": "integer",
          "minimum": 1,
          "description": "",
          "x-default": "`2`"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "description": "",
          "x-default": "`6`"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "description": "average CPU utilization, relative to the containers' CPU requests",
          "x-default": "`70`"
        }
      }
