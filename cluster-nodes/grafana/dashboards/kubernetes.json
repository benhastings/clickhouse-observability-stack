      "type": "table",
      "title": "Usage against requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
