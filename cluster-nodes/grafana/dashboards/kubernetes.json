{
  "uid": "kubernetes",
  "title": "Kubernetes",
  "tags": [
    "kubernetes",
    "cerberus",
    "clickhouse"
  ],
  "editable": true,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cerberus-prometheus"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "definition": "label_values(k8s_node_condition_ready, k8s_node_name)",
        "query": {
          "query": "label_values(k8s_node_condition_ready, k8s_node_name)",
          "refId": "node"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cerberus-prometheus"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "definition": "label_values(k8s_pod_phase, k8s_namespace_name)",
        "query": {
          "query": "label_values(k8s_pod_phase, k8s_namespace_name)",
          "refId": "namespace"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Nodes, pods and containers from the collector's `kubeletstats` and `k8s_cluster` receivers. Load average needs the `hostmetrics` receiver, which runs in the collector agent (off by default), so this dashboard leaves it out."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Nodes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node CPU (cores)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^allocatable .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "max by (k8s_node_name) (k8s_node_cpu_usage{k8s_node_name=~\"$node\"})",
          "refId": "A",
          "legendFormat": "used {{k8s_node_name}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "max by (k8s_node_name) (k8s_node_allocatable_cpu{k8s_node_name=~\"$node\"})",
          "refId": "B",
          "legendFormat": "allocatable {{k8s_node_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Node memory",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^allocatable .*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "max by (k8s_node_name) (k8s_node_memory_working_set{k8s_node_name=~\"$node\"})",
          "refId": "A",
          "legendFormat": "working set {{k8s_node_name}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "max by (k8s_node_name) (k8s_node_allocatable_memory{k8s_node_name=~\"$node\"})",
          "refId": "B",
          "legendFormat": "allocatable {{k8s_node_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node filesystem used",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "max by (k8s_node_name) (k8s_node_filesystem_usage{k8s_node_name=~\"$node\"}) / max by (k8s_node_name) (k8s_node_filesystem_capacity{k8s_node_name=~\"$node\"})",
          "refId": "A",
          "legendFormat": "{{k8s_node_name}}",
          "range": true
        }
      ],
      "description": "The node's root filesystem, which holds images, container layers, logs and emptyDir volumes. The kubelet evicts pods under disk pressure."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node network",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_node_name, direction) (rate(k8s_node_network_io{k8s_node_name=~\"$node\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{direction}} {{k8s_node_name}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_node_name) (rate(k8s_node_network_errors{k8s_node_name=~\"$node\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "errors {{k8s_node_name}}",
          "range": true
        }
      ]
    },
