          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_namespace_name) (k8s_container_cpu_request{k8s_namespace_name=~\"$namespace\"})",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_namespace_name) (k8s_pod_memory_working_set{k8s_namespace_name=~\"$namespace\"})",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_namespace_name) (k8s_container_memory_request{k8s_namespace_name=~\"$namespace\"})",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (k8s_namespace_name) (k8s_container_memory_limit{k8s_namespace_name=~\"$namespace\"})",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "k8s_namespace_name": "Namespace",
              "Value #A": "CPU used",
              "Value #B": "CPU requested",
              "Value #C": "Memory used",
              "Value #D": "Memory requested",
              "Value #E": "Memory limits"
            },
            "indexByName": {
              "k8s_namespace_name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            }
          }
        }
      ],
      "description": "CPU in cores. Requested is what the scheduler reserved; a namespace using far more than it requested is the first to suffer on a busy node."
