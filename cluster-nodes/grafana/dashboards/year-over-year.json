            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "month",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-rollup"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toStartOfMonth(Bucket) AS month, ServiceName AS service, sum(Requests) AS requests,\n       sum(Errors) / sum(Requests) AS \"error ratio\",\n       quantilesTDigestMerge(0.5, 0.9, 0.95, 0.99)(DurationMs)[3] AS \"p95 (ms)\"\nFROM otel_rollup.service_1h\nWHERE Bucket >= toStartOfMonth(now() - INTERVAL 12 MONTH) AND ServiceName IN (${service:singlequote})\nGROUP BY month, service ORDER BY month DESC, service"
        }
      ]
    }
  ]
