{
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Span metrics (RED)**: rate, errors and duration derived from traces by the OTel Collector's `spanmetrics` connector, stored in ClickHouse, and queried here with PromQL through Cerberus. Click a series for links to its failing or slow traces, its error logs, and Traces and Logs Drilldown. Exemplar dots are off until Cerberus answers exemplar queries for aggregated expressions (tsouza/cerberus#3787).",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "reqps",
          "links": [
            {
              "title": "Traces Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-exploretraces-app/explore?from=${__from}&to=${__to}&var-ds=cerberus-tempo&var-filters=resource.service.name%7C%3D%7C${__field.labels.service_name:percentencode}&var-metric=rate&var-primarySignal=true&actionView=breakdown"
            },
            {
              "title": "Logs Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-lokiexplore-app/explore/service/${__field.labels.service_name:percentencode}/logs?from=${__from}&to=${__to}&var-ds=cerberus-loki"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Requests per second",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit",
          "links": [
            {
              "title": "Failing traces of ${__field.labels.service_name}",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22cerberus-tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22cerberus-tempo%22%7D%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22${__field.labels.service_name:percentencode}%5C%22%20%26%26%20kind%3Dserver%20%26%26%20status%3Derror%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            },
            {
              "title": "Error logs of ${__field.labels.service_name}",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22cerberus-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22cerberus-loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22${__field.labels.service_name:percentencode}%5C%22%7D%20%7C%20detected_level%3D~%5C%22error%7Ccritical%7Cfatal%5C%22%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            },
            {
              "title": "Traces Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-exploretraces-app/explore?from=${__from}&to=${__to}&var-ds=cerberus-tempo&var-filters=resource.service.name%7C%3D%7C${__field.labels.service_name:percentencode}&var-metric=rate&var-primarySignal=true&actionView=breakdown"
            },
            {
              "title": "Logs Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-lokiexplore-app/explore/service/${__field.labels.service_name:percentencode}/logs?from=${__from}&to=${__to}&var-ds=cerberus-loki"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "expr": "(sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) * 0) / sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "ms",
          "links": [
            {
              "title": "Traces of ${__field.labels.service_name} slower than ${__value.text}",
              "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22cerberus-tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22cerberus-tempo%22%7D%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22${__field.labels.service_name:percentencode}%5C%22%20%26%26%20kind%3Dserver%20%26%26%20duration%20%3E%20${__value.raw}ms%7D%22%2C%22queryType%22%3A%22traceql%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D"
            },
            {
              "title": "Traces Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-exploretraces-app/explore?from=${__from}&to=${__to}&var-ds=cerberus-tempo&var-filters=resource.service.name%7C%3D%7C${__field.labels.service_name:percentencode}&var-metric=rate&var-primarySignal=true&actionView=breakdown"
            },
            {
              "title": "Logs Drilldown: ${__field.labels.service_name}",
              "url": "/a/grafana-lokiexplore-app/explore/service/${__field.labels.service_name:percentencode}/logs?from=${__from}&to=${__to}&var-ds=cerberus-loki"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "expr": "histogram_quantile(0.5, sum by (le, service_name) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} p99",
          "refId": "C"
        }
      ],
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "id": 7,
      "title": "Server latency heatmap",
      "description": "Server-span durations per bucket for the selected services.",
      "type": "heatmap",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false,
          "scale": "exponential",
          "steps": 64
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true,
          "showColorScale": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "ms"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "exemplar": false,
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A",
          "expr": "sum by (le) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "cerberus-tempo"
      },
      "id": 8,
      "title": "Service graph",
      "description": "Calls between services from the servicegraph connector, limited to edges where a selected service is the client or the server. Click a node for its RED metrics and traces.",
      "type": "nodeGraph",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "options": {
        "edges": {},
        "nodes": {}
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "cerberus-tempo"
          },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": [
            "{client=~\"$service\"}",
            "{server=~\"$service\"}"
          ]
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "cerberus-loki"
      },
      "id": 9,
      "title": "Error logs",
      "description": "Error, critical and fatal logs of the selected services. Expand a line for its trace_id and the link to its trace.",
      "type": "logs",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cerberus-loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=~\"$service\"} | detected_level=~\"error|critical|fatal\""
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Req/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 5,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Req/s"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum by (service_name, span_name) (rate(traces_span_metrics_calls{service_name=~\"$service\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "(sum by (service_name, span_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) or sum by (service_name, span_name) (rate(traces_span_metrics_calls{service_name=~\"$service\"}[5m])) * 0) / sum by (service_name, span_name) (rate(traces_span_metrics_calls{service_name=~\"$service\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_bucket{service_name=~\"$service\"}[5m])))",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "Operations (last 5m)",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Req/s",
              "Value #B": "Error rate",
              "Value #C": "p95 (ms)",
              "service_name": "Service",
              "span_name": "Operation"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per minute against the hour-of-week baseline",
      "description": "Observed server requests per minute (solid), the median for this hour of the week over the last 4 weeks (dashed; otel_baseline in ClickHouse), and 3 robust standard deviations (1.4826 \u00d7 MAD) either side (dotted). Empty until the baseline views have run.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "refId": "A",
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (rate(traces_span_metrics_calls{service_name=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) * 60"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "refId": "B",
          "legendFormat": "{{service_name}} baseline",
          "expr": "max by (service_name) (baseline:requests_per_minute:median{service_name=~\"$service\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "refId": "C",
          "legendFormat": "{{service_name}} upper",
          "expr": "max by (service_name) (baseline:requests_per_minute:median{service_name=~\"$service\"} + 3 * 1.4826 * baseline:requests_per_minute:mad{service_name=~\"$service\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "refId": "D",
          "legendFormat": "{{service_name}} lower",
          "expr": "max by (service_name) (clamp_min(baseline:requests_per_minute:median{service_name=~\"$service\"} - 3 * 1.4826 * baseline:requests_per_minute:mad{service_name=~\"$service\"}, 0))"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "span-metrics",
    "cerberus",
    "clickhouse"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "cerberus-prometheus"
        },
        "definition": "label_values(traces_span_metrics_calls, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": {
          "query": "label_values(traces_span_metrics_calls, service_name)",
          "refId": "svc"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Span metrics (RED)",
  "uid": "span-metrics-red",
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "loki",
          "uid": "cerberus-loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Alerts firing",
        "expr": "{service_name=\"alertmanager\"} | status=\"firing\"",
        "titleFormat": "{{alertname}} firing",
        "textFormat": "{{alert_service_name}}",
        "tagKeys": "alertname,alert_service_name,severity",
        "instant": false
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "cerberus-loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "name": "Alerts resolved",
        "expr": "{service_name=\"alertmanager\"} | status=\"resolved\"",
        "titleFormat": "{{alertname}} resolved",
        "textFormat": "{{alert_service_name}}",
        "tagKeys": "alertname,alert_service_name,severity",
        "instant": false
      }
    ]
  }
}
