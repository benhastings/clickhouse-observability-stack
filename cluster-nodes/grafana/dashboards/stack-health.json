            "uid": "cerberus-prometheus"
          },
          "expr": "sum(rate(ClickHouseProfileEvents_FailedInsertQuery[$__rate_interval]))",
          "refId": "A",
          "range": true,
          "legendFormat": "failed inserts"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum(rate(ClickHouseProfileEvents_FailedSelectQuery[$__rate_interval]))",
          "refId": "B",
          "range": true,
          "legendFormat": "failed selects"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum(rate(ClickHouseErrorMetric_MEMORY_LIMIT_EXCEEDED[$__rate_interval]))",
          "refId": "C",
          "range": true,
          "legendFormat": "MEMORY_LIMIT_EXCEEDED"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          },
          "expr": "sum(rate(ClickHouseErrorMetric_TOO_MANY_PARTS[$__rate_interval]))",
          "refId": "D",
          "range": true,
          "legendFormat": "TOO_MANY_PARTS"
        }
      ],
      "description": "A failed insert is retried by the collector's exporter, and dropped once its retries run out."
    },
