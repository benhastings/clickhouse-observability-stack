# Literal values check-credentials.bash allows. One per line: a file glob, a tab, then the exact line
# (leading spaces and "- " removed). Say why each one is not a secret.
#
# The operator's vendored config (cluster-nodes/clickhouse-operator/files/config.yaml) gives the
# "default" ClickHouse user of an installation it creates the upstream placeholder password "default".
# That user is limited to localhost (networksIP ::1 and 127.0.0.1); the stack's users read their
# passwords from clickhouse-credentials.
*clickhouse-operator*	password: default
